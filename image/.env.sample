RABBITMQ_HOST_NAME="message-broker" # This name should match what the rabbit-mq container service name is and not container_name. 

# The containers values as a consumer
RABBITMQ_CONSUMER_QUEUE="request.queue"

# The containers values as a producer
RABBITMQ_PRODUCER_QUEUE="response.queue"
RABBITMQ_PRODUCER_EXCHANGE="response.exchange"
RABBITMQ_PRODUCER_ROUTING="response.routing"

RABBITMQ_USERNAME="default-bla" # Dont use 'guest', wont work in prod
RABBITMQ_PASSWORD="default-bla" # Dont use 'guest', wont work in prod
